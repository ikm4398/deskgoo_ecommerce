import frappe
from frappe.utils import pretty_date


def _require_login():
    if frappe.session.user == "Guest":
        frappe.throw("Login required", frappe.PermissionError)


@frappe.whitelist(methods=["POST"])
def create():
    _require_login()

    data = frappe.request.get_json()

    blog_name = data.get("blog_name")
    comment = data.get("comment")

    if not blog_name or not comment:
        frappe.throw("blog_name and comment are required")

    # Get Blog Post
    blog = frappe.get_doc("Blog Post", blog_name)

    # Add Comment
    new_comment = blog.add_comment(
        "Comment",
        f'<div class="ql-editor read-mode"><p>{comment}</p></div>'
    )

    frappe.db.commit()

    return {
        "status": "success",
        "message": "Comment added",
        "data": {
            "name": new_comment.name,
            "comment": new_comment.content,
            "by": new_comment.owner,
            "creation": new_comment.creation,
            "pretty_date": pretty_date(new_comment.creation)
        }
    }


@frappe.whitelist(allow_guest=True)
def get_comments(blog_name):

    comments = frappe.get_all(
        "Comment",
        filters={
            "reference_doctype": "Blog Post",
            "reference_name": blog_name,
            "comment_type": "Comment"
        },
        fields=[
            "name",
            "content",
            "owner",
            "creation"
        ],
        order_by="creation asc"
    )

    # Add human readable date
    for comment in comments:
        comment["pretty_date"] = pretty_date(comment["creation"])

    return {
        "status": "success",
        "data": comments
    }
