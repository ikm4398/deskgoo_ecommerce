  "event_frequency": "All",
  "modified": "2026-02-10 15:31:43.008337",
  "module": "Deskgoo Ecommerce",
  "name": "item details",
  "rate_limit_count": 5,
  "rate_limit_seconds": 86400,
  "reference_doctype": null,
  "script": "# myapp/api/item.py\r\nimport frappe\r\nfrom erpnext.stock.utils import get_latest_stock_qty\r\nfrom frappe import _\r\n\r\n@frappe.whitelist()\r\ndef get_items_with_price_and_stock(price_list=\"Standard Selling\", warehouse=None, limit=100):\r\n    # price_list = your selling price list name\r\n    items = frappe.get_all(\r\n        \"Item\",\r\n        filters={\"disabled\": 0, \"is_sales_item\": 1},\r\n        fields=[\"name\", \"item_code\", \"item_name\", \"stock_uom\"],\r\n        limit=limit\r\n    )\r\n\r\n    result = []\r\n    for item in items:\r\n        # Get selling price (latest from Item Price doctype)\r\n        price = frappe.db.get_value(\r\n            \"Item Price\",\r\n            {\"item_code\": item.item_code, \"price_list\": price_list},\r\n            \"price_list_rate\"\r\n        ) or 0\r\n\r\n        # Get stock (total across all warehouses or specify warehouse)\r\n        if warehouse:\r\n            stock = frappe.db.get_value(\r\n                \"Bin\",\r\n                {\"item_code\": item.item_code, \"warehouse\": warehouse},\r\n                \"actual_qty\"\r\n            ) or 0\r\n        else:\r\n            # Total stock (slower for large catalogs)\r\n            stock = get_latest_stock_qty(item.item_code) or 0\r\n\r\n        result.append({\r\n            \"item_name\": item.item_name or item.item_code,\r\n            \"price\": float(price),              # selling price (not valuation rate)\r\n            \"instock_quantity\": float(stock)    # actual available qty\r\n        })\r\n\r\n    return result",
  "script_type": "API"
 },
 {
  "allow_guest": 0,
  "api_method": "daily_deals",
  "cron_format": null,
  "disabled": 0,
  "docstatus": 0,
  "doctype": "Server Script",
  "doctype_event": "Before Insert",
  "enable_rate_limit": 0,
  "event_frequency": "All",
  "modified": "2026-02-18 14:04:07.971352",
  "module": null,
  "name": "daily_deals",
  "rate_limit_count": 5,
  "rate_limit_seconds": 86400,
  "reference_doctype": null,
  "script": "discount_percentage = int(frappe.request.args.get(\"discount\", 80))\ndiscount_multiplier = (100 - discount_percentage) / 100\n\nitems = frappe.get_all(\n    \"Item\",\n    filters={\"disabled\": 0},\n    fields=[\"name\", \"item_name\", \"image\", \"standard_rate\"],\n    order_by=\"modified desc\"\n)\n\nproducts = []\n\nfor it in items:\n\n    bin_data = frappe.get_all(\n        \"Bin\",\n        filters={\"item_code\": it.name},\n        fields=[\"actual_qty\"],\n        limit=1\n    )\n\n    stock_qty = bin_data[0].actual_qty if bin_data else 0\n\n    original_price = it.standard_rate or 0\n    discounted_price = original_price * discount_multiplier\n\n    products.append({\n        \"item_code\": it.name,\n        \"name\": it.item_name,\n        \"image\": it.image,\n        \"original_price\": original_price,\n        \"discounted_price\": discounted_price,\n        \"stock\": stock_qty,\n        \"stock_label\": f\"Only {int(stock_qty)} left!\" if stock_qty > 0 else \"Out of stock\"\n    })\n\nfrappe.response[\"message\"] = {\n    \"title\": \"Catch Daily Deals!\",\n    \"discount_percentage\": discount_percentage,\n    \"discount_label\": f\"-{discount_percentage}% OFF\",   \n    \"products\": products\n}\n",
  "script_type": "API"
 },
 {
  "allow_guest": 1,
  "api_method": "forgetpassword.sendotp",
  "cron_format": null,
  "disabled": 0,
  "docstatus": 0,
  "doctype": "Server Script",
  "doctype_event": "Before Insert",
  "enable_rate_limit": 0,
  "event_frequency": "All",
  "modified": "2026-05-22 11:15:26.083753",
  "module": "Deskgoo Ecommerce",
  "name": "Send OTP",
  "rate_limit_count": 5,
  "rate_limit_seconds": 86400,
  "reference_doctype": null,
  "script": "email = frappe.form_dict.get(\"email\")\n\nif not email:\n    frappe.throw(\"Email is required\")\n\nuser = frappe.db.get_value(\"User\", {\"email\": email}, \"name\")\n\nif not user:\n    frappe.throw(\"No user found with this email\")\n\nnow_text = str(frappe.utils.now_datetime())\notp = now_text[-6:].replace(\".\", \"\").replace(\":\", \"\").replace(\"-\", \"\").replace(\" \", \"\")\n\notp_doc = frappe.get_doc({\n    \"doctype\": \"Password Reset OTP\",\n    \"email\": email,\n    \"otp\": otp,\n    \"expires_at\": frappe.utils.add_to_date(frappe.utils.now_datetime(), minutes=10),\n    \"is_verified\": 0,\n    \"is_used\": 0\n})\n\notp_doc.insert(ignore_permissions=True)\n\nfrappe.response[\"message\"] = {\n    \"status\": \"success\",\n    \"message\": \"OTP created successfully\",\n    \"otp\": otp\n}",
  "script_type": "API"
 },
 {
  "allow_guest": 1,
  "api_method": "forgetpassword.verifyotp",
  "cron_format": null,
  "disabled": 0,
  "docstatus": 0,
  "doctype": "Server Script",
  "doctype_event": "Before Insert",
  "enable_rate_limit": 0,
  "event_frequency": "All",
  "modified": "2026-05-21 16:57:00.803439",
  "module": "Deskgoo Ecommerce",
  "name": "Verify OTP",
  "rate_limit_count": 5,
  "rate_limit_seconds": 86400,
  "reference_doctype": null,
  "script": "email = frappe.form_dict.get(\"email\")\notp = frappe.form_dict.get(\"otp\")\n\nif not email or not otp:\n    frappe.throw(\"Email and OTP are required\")\n\notp_doc = frappe.db.get_value(\n    \"Password Reset OTP\",\n    {\n        \"email\": email,\n        \"otp\": otp,\n        \"is_used\": 0\n    },\n    [\"name\", \"expires_at\"],\n    as_dict=True,\n    order_by=\"creation desc\"\n)\n\nif not otp_doc:\n    frappe.throw(\"Invalid OTP\")\n\nif frappe.utils.now_datetime() > otp_doc.expires_at:\n    frappe.throw(\"OTP has expired\")\n\nfrappe.db.set_value(\n    \"Password Reset OTP\",\n    otp_doc.name,\n    \"is_verified\",\n    1\n)\n\nfrappe.response[\"message\"] = {\n    \"status\": \"success\",\n    \"message\": \"OTP verified successfully\"\n}",
  "script_type": "API"
 },
 {
  "allow_guest": 1,
  "api_method": "forgetpassword.resetpassword",
  "cron_format": null,
  "disabled": 0,
  "docstatus": 0,
  "doctype": "Server Script",
  "doctype_event": "Before Insert",
  "enable_rate_limit": 0,
  "event_frequency": "All",
  "modified": "2026-05-21 16:55:24.498513",
  "module": "Deskgoo Ecommerce",
  "name": "Forget Password",
  "rate_limit_count": 5,
  "rate_limit_seconds": 86400,
  "reference_doctype": null,
  "script": "email = frappe.form_dict.get(\"email\")\nnew_password = frappe.form_dict.get(\"new_password\")\n\nif not email:\n    frappe.throw(\"Email is required\")\n\nif not new_password:\n    frappe.throw(\"New Password is required\")\n\nuser = frappe.db.get_value(\"User\", {\"email\": email}, \"name\")\n\nif not user:\n    frappe.throw(\"User not found\")\n\nuser_doc = frappe.get_doc(\"User\", user)\nuser_doc.new_password = new_password\nuser_doc.save(ignore_permissions=True)\n\nfrappe.response[\"message\"] = {\n    \"status\": \"success\",\n    \"message\": \"Password updated successfully\"\n}",
  "script_type": "API"
 },
 {
  "allow_guest": 0,
  "api_method": "salesorderdetails",
  "cron_format": null,
  "disabled": 0,
  "docstatus": 0,
  "doctype": "Server Script",
  "doctype_event": "Before Insert",
  "enable_rate_limit": 0,
  "event_frequency": "All",
  "modified": "2026-05-23 20:44:21.734642",
  "module": "Deskgoo Ecommerce",
  "name": "Sales Order Details",
  "rate_limit_count": 5,
  "rate_limit_seconds": 86400,
  "reference_doctype": null,
  "script": "sales_order_id = frappe.form_dict.get(\"sales_order_id\")\n\nfilters = {}\n\nif sales_order_id:\n    filters[\"name\"] = sales_order_id\n\nsales_orders = frappe.get_all(\n    \"Sales Order\",\n    filters=filters,\n    fields=[\n        \"name\",\n        \"customer\",\n        \"customer_name\",\n        \"transaction_date\",\n        \"delivery_date\",\n        \"status\",\n        \"docstatus\",\n        \"grand_total\",\n        \"rounded_total\",\n        \"total_qty\",\n        \"currency\",\n        \"company\",\n        \"contact_person\",\n        \"contact_email\",\n        \"contact_mobile\",\n        \"address_display\",\n    ],\n    order_by=\"creation desc\"\n)\n\nfinal_data = []\n\nfor so in sales_orders:\n\n    items = frappe.get_all(\n        \"Sales Order Item\",\n        filters={\n            \"parent\": so.name\n        },\n        fields=[\n            \"item_code\",\n            \"item_name\",\n            \"description\",\n            \"qty\",\n            \"uom\",\n            \"rate\",\n            \"amount\",\n            \"warehouse\",\n            \"delivery_date\"\n        ]\n    )\n\n    so[\"items\"] = items\n\n    final_data.append(so)\n\nfrappe.response[\"message\"] = {\n    \"status\": \"success\",\n    \"total_orders\": len(final_data),\n    \"data\": final_data\n}",
  "script_type": "API"
 },
 {
  "allow_guest": 0,
  "api_method": "cancelorder",
  "cron_format": null,
  "disabled": 0,
  "docstatus": 0,
  "doctype": "Server Script",
  "doctype_event": "Before Insert",
  "enable_rate_limit": 0,
  "event_frequency": "All",
  "modified": "2026-05-24 11:28:54.962122",
  "module": "Deskgoo Ecommerce",
  "name": "Cancel Order API",
  "rate_limit_count": 5,
  "rate_limit_seconds": 86400,
  "reference_doctype": null,
  "script": "sales_order_id = frappe.form_dict.get(\"sales_order_id\")\n\nif not sales_order_id:\n    frappe.throw(\"Sales Order ID is required\")\n\nif not frappe.db.exists(\"Sales Order\", sales_order_id):\n    frappe.throw(\"Sales Order not found\")\n\nsales_order = frappe.get_doc(\"Sales Order\", sales_order_id)\n\nif sales_order.docstatus == 2:\n    frappe.throw(\"Sales Order is already cancelled\")\n\nif sales_order.docstatus == 0:\n    frappe.delete_doc(\"Sales Order\", sales_order_id, ignore_permissions=True)\n\n    frappe.response[\"message\"] = {\n        \"status\": \"success\",\n        \"message\": \"Draft Sales Order deleted successfully\"\n    }\n\nelse:\n    sales_order.cancel()\n\n    frappe.response[\"message\"] = {\n        \"status\": \"success\",\n        \"message\": \"Sales Order cancelled successfully\"\n    }",
  "script_type": "API"
 },
 {
  "allow_guest": 1,
  "api_method": "get_faqs",
  "cron_format": null,
  "disabled": 0,
  "docstatus": 0,
  "doctype": "Server Script",
  "doctype_event": "Before Insert",
  "enable_rate_limit": 0,
  "event_frequency": "All",
  "modified": "2026-06-08 15:21:30.135014",
  "module": "Deskgoo Ecommerce",
  "name": "faq",
  "rate_limit_count": 5,
  "rate_limit_seconds": 86400,
  "reference_doctype": null,
  "script": "faq_documents = frappe.get_all(\"FAQ\", filters={\"published\": 1}, fields=[\"name\", \"title\"])\r\nresult = []\r\n\r\nfor faq in faq_documents:\r\n    doc = frappe.get_doc(\"FAQ\", faq.name)\r\n    faq_data = {\r\n        \"name\": faq.name,\r\n        \"title\": faq.title or \"Frequently Asked Questions\",\r\n        \"faq_items\": []\r\n    }\r\n    \r\n    if doc.faq_items:\r\n        for item in doc.faq_items:\r\n            faq_data[\"faq_items\"].append({\r\n                \"question\": item.question,\r\n                \"answer\": item.answer\r\n            })\r\n    \r\n    result.append(faq_data)\r\n\r\nfrappe.response[\"message\"] = result",
  "script_type": "API"
 },
 {
  "allow_guest": 1,
  "api_method": "get_customer_notifications",
  "cron_format": null,
  "disabled": 0,
  "docstatus": 0,
  "doctype": "Server Script",
  "doctype_event": "Before Insert",
  "enable_rate_limit": 0,
  "event_frequency": "All",
  "modified": "2026-06-11 15:34:09.530693",
  "module": "Deskgoo Ecommerce",
  "name": "Customer Notification",
  "rate_limit_count": 5,
  "rate_limit_seconds": 86400,
  "reference_doctype": null,
  "script": "user = frappe.session.user\n\nif user == \"Guest\":\n    frappe.response[\"message\"] = {\n        \"success\": False,\n        \"message\": \"Please login to view notifications\",\n        \"status\": 401\n    }\nelse:\n    notifications = []\n\n    orders = frappe.db.sql(\"\"\"\n        SELECT\n            so.name as id,\n            so.customer as customer_id,\n            'Order' as type,\n            so.status as erp_status,\n            so.docstatus as docstatus,\n            so.modified as created_at,\n            so.grand_total,\n            so.currency\n        FROM `tabSales Order` so\n        WHERE so.docstatus IN (0, 1, 2)\n        ORDER BY so.modified DESC\n        LIMIT 20\n    \"\"\", as_dict=True)\n\n    for order in orders:\n        erp_status = order[\"erp_status\"]\n        docstatus = order[\"docstatus\"]\n\n        if docstatus == 0:\n            display_status = \"Processing\"\n            message = \"Your order is now being processed\"\n\n        elif erp_status == \"To Deliver and Bill\":\n            display_status = \"On The Way\"\n            message = \"Your order is on the way\"\n\n        elif erp_status == \"To Deliver\":\n            display_status = \"On The Way\"\n            message = \"Your order is on the way\"\n\n        elif erp_status == \"To Bill\":\n            display_status = \"Billing Pending\"\n            message = \"Your order has been delivered and billing is pending\"\n\n        elif erp_status == \"Completed\":\n            display_status = \"Delivered\"\n            message = \"Your order has been delivered successfully\"\n\n        elif erp_status == \"Cancelled\" or docstatus == 2:\n            display_status = \"Cancelled\"\n            message = \"Your order has been cancelled\"\n\n        else:\n            display_status = erp_status\n            message = \"Your order status is \" + display_status\n\n        order[\"title\"] = display_status\n        order[\"message\"] = message\n        order[\"is_read\"] = 0\n\n        notifications.append(order)\n\n    frappe.response[\"message\"] = {\n        \"success\": True,\n        \"data\": {\n            \"notifications\": notifications,\n            \"summary\": {\n                \"total\": len(notifications),\n                \"unread\": len(notifications),\n                \"orders\": len(notifications),\n                \"offers\": 0,\n                \"system\": 0\n            }\n        }\n    }",
  "script_type": "API"
 }
]